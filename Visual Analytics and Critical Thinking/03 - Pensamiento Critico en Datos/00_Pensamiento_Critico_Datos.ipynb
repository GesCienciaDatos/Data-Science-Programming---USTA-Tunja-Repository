    "# ============================================================\n",
    "# El truco más común: Eje Y truncado\n",
    "# Mismo dataset — percepción radicalmente diferente\n",
    "# ============================================================\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "# Datos de aprobación presidencial (hipotético)\n",
    "meses = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun']\n",
    "aprobacion = [52.1, 51.8, 52.5, 51.9, 52.8, 53.2]  # variación real: <1.5%\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 6))\n",
    "fig.suptitle('El Mismo Dato — Dos Historias Completamente Diferentes',\n",
    "             fontsize=13, fontweight='bold')\n",
    "\n",
    "# Gráfico engañoso: eje truncado\n",
    "axes[0].plot(meses, aprobacion, 'o-', color='#dc2626', linewidth=3,\n",
    "             markersize=8, markerfacecolor='white', markeredgewidth=2)\n",
    "axes[0].fill_between(range(len(meses)), aprobacion, min(aprobacion)-0.1,\n",
    "                     alpha=0.3, color='#dc2626')\n",
    "axes[0].set_ylim(51.5, 53.5)  # ¡EJE TRUNCADO!\n",
    "axes[0].set_xticks(range(len(meses)))\n",
    "axes[0].set_xticklabels(meses)\n",
    "axes[0].set_ylabel('Aprobación (%)', fontsize=10)\n",
    "axes[0].set_title('❌ ENGAÑOSO: Eje Y truncado (51.5–53.5%)\\n'\n",
    "                  '\"¡La aprobación se DISPARÓ!\"', fontsize=11, color='#dc2626')\n",
    "axes[0].spines['top'].set_visible(False)\n",
    "axes[0].spines['right'].set_visible(False)\n",
    "axes[0].yaxis.grid(True, alpha=0.3)\n",
    "\n",
    "# Gráfico honesto: eje desde 0\n",
    "axes[1].plot(meses, aprobacion, 'o-', color='#1e3a8a', linewidth=3,\n",
    "             markersize=8, markerfacecolor='white', markeredgewidth=2)\n",
    "axes[1].fill_between(range(len(meses)), aprobacion, 0,\n",
    "                     alpha=0.1, color='#1e3a8a')\n",
    "axes[1].set_ylim(0, 100)  # Escala completa\n",
    "axes[1].set_xticks(range(len(meses)))\n",
    "axes[1].set_xticklabels(meses)\n",
    "axes[1].set_ylabel('Aprobación (%)', fontsize=10)\n",
    "axes[1].set_title('✅ HONESTO: Eje Y desde 0 (0–100%)\\n'\n",
    "                  '\"La aprobación es estable ~52%\"', fontsize=11, color='#1e3a8a')\n",
    "axes[1].spines['top'].set_visible(False)\n",
    "axes[1].spines['right'].set_visible(False)\n",
    "axes[1].yaxis.grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "variacion_real = max(aprobacion) - min(aprobacion)\n",
    "print(f\"\\n📊 Variación real en los datos: {variacion_real:.1f} puntos porcentuales\")\n",
    "print(f\"   Sobre una escala de 100%: {variacion_real:.1f}% de variación\")\n",
    "print(f\"   Conclusión objetiva: estadísticamente insignificante\")\n",
    "\n",
    "print(\"\\n📊 En Power BI: El eje Y por defecto NO empieza en 0.\")\n",
    "print(\"   Para corregir: Panel Formato → Eje Y → 'Inicio' → escribir 0\")\n",
    "print(\"\\n📈 En Tableau: Click derecho en eje → 'Editar eje' → 'Rango fijo' → Min: 0\")"
