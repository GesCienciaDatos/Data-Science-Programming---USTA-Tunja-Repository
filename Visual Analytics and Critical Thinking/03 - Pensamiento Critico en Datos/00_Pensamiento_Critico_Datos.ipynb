   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# Correlaciones Espurias: Datos reales, conclusiones absurdas\n",
    "# Fuente: Tyler Vigen - Spurious Correlations\n",
    "# ============================================================\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "from scipy import stats\n",
    "\n",
    "# Caso real: consumo de mozzarella (kg/persona) vs doctorados en ingeniería civil (EEUU)\n",
    "años = np.arange(2000, 2010)\n",
    "mozzarella = np.array([9.3, 9.7, 10.1, 10.2, 10.6, 10.8, 11.0, 10.9, 11.2, 11.3])\n",
    "doctorados_ing_civil = np.array([480, 501, 540, 552, 547, 560, 578, 595, 594, 606])\n",
    "\n",
    "# Calcular correlación\n",
    "r, p_value = stats.pearsonr(mozzarella, doctorados_ing_civil)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 6))\n",
    "fig.suptitle(f'Correlación Espuria — r = {r:.4f} (p < 0.001)\\n'\n",
    "             f'¡Alta correlación estadística, CERO causalidad!',\n",
    "             fontsize=12, fontweight='bold')\n",
    "\n",
    "# Doble eje Y\n",
    "ax1 = axes[0]\n",
    "color1, color2 = '#3b82f6', '#f59e0b'\n",
    "l1 = ax1.plot(años, mozzarella, 'o-', color=color1, linewidth=2.5, label='Mozzarella (kg/persona)')\n",
    "ax1.set_xlabel('Año', fontsize=10)\n",
    "ax1.set_ylabel('Consumo de Mozzarella (kg/persona)', color=color1, fontsize=9)\n",
    "ax1.tick_params(axis='y', labelcolor=color1)\n",
    "\n",
    "ax1b = ax1.twinx()\n",
    "l2 = ax1b.plot(años, doctorados_ing_civil, 's--', color=color2, linewidth=2.5,\n",
    "               label='Doctorados Ing. Civil')\n",
    "ax1b.set_ylabel('Doctorados en Ing. Civil (EEUU)', color=color2, fontsize=9)\n",
    "ax1b.tick_params(axis='y', labelcolor=color2)\n",
    "\n",
    "lines = l1 + l2\n",
    "labels = [l.get_label() for l in lines]\n",
    "ax1.legend(lines, labels, loc='upper left', fontsize=9)\n",
    "ax1.set_title(f'¿\"Comer más mozzarella produce más ingenieros\"? r={r:.3f}',\n",
    "              fontsize=10)\n",
    "ax1.spines['top'].set_visible(False)\n",
    "\n",
    "# Scatter con regresión\n",
    "m, b, r_scatter, _, _ = stats.linregress(mozzarella, doctorados_ing_civil)\n",
    "x_line = np.linspace(mozzarella.min(), mozzarella.max(), 100)\n",
    "axes[1].scatter(mozzarella, doctorados_ing_civil, color=color1, s=100,\n",
    "                zorder=5, edgecolors='white', linewidths=1.5)\n",
    "axes[1].plot(x_line, m * x_line + b, '--', color='#dc2626', linewidth=2)\n",
    "\n",
    "for i, año in enumerate(años):\n",
    "    axes[1].annotate(str(año), (mozzarella[i], doctorados_ing_civil[i]),\n",
    "                     textcoords='offset points', xytext=(5, 5), fontsize=8)\n",
    "\n",
    "axes[1].set_xlabel('Consumo de Mozzarella (kg/persona)', fontsize=10)\n",
    "axes[1].set_ylabel('Doctorados en Ing. Civil (EEUU)', fontsize=10)\n",
    "axes[1].set_title(f'Scatter: r² = {r**2:.3f} — Excelente ajuste lineal\\n'\n",
    "                  f'¡Pero la pizza NO genera ingenieros!', fontsize=10)\n",
    "axes[1].spines['top'].set_visible(False)\n",
    "axes[1].spines['right'].set_visible(False)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(f\"\\n📊 Correlación de Pearson: r = {r:.4f}\")\n",
    "print(f\"   R² = {r**2:.4f} → El 'modelo' explica el {r**2*100:.1f}% de la varianza\")\n",
    "print(f\"   p-value = {p_value:.6f} → Estadísticamente significativo\")\n",
    "print(f\"\\n⚠️  PERO: La variable de confusión es el TIEMPO (ambas crecen con los años)\")\n",
    "print(f\"   La solución: controlar por tendencia temporal o usar diferencias\")"
   ]
